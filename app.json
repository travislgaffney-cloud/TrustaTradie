{
  "expo": {
    "name": "Trust-a-Tradie",
    "slug": "trust-a-tradie",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "trustatradie",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.trustatradie.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Trust-a-Tradie uses your location to show nearby jobs and tradies.",
        "NSLocationAlwaysUsageDescription": "Trust-a-Tradie uses your location to notify tradies of nearby jobs.",
        "NSCameraUsageDescription": "Used to take photos for job posts and portfolio images.",
        "NSPhotoLibraryUsageDescription": "Used to upload photos for jobs, portfolio, and documents.",
        "NSMicrophoneUsageDescription": "Required for camera access.",
        "NSCalendarsUsageDescription": "Trust-a-Tradie adds your booked jobs to your calendar.",
        "NSCalendarsFullAccessUsageDescription": "Trust-a-Tradie adds your booked jobs to your calendar.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.trustatradie.app",
      "adaptiveIcon": {
        "backgroundColor": "#1B2D4F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#0f172a"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Trust-a-Tradie uses your location to show nearby jobs and tradies."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Used to take photos for job posts and portfolio images."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Used to upload photos for jobs, portfolio, and documents."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#F97316",
          "sounds": []
        }
      ],
      "expo-font",
      "expo-calendar",
      "expo-web-browser",
      [
        "@sentry/react-native/expo",
        {
          "organization": "trustatradie",
          "project": "react-native",
          "url": "https://sentry.io/"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "593b69a2-885e-4a2c-b950-46260707acce"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/593b69a2-885e-4a2c-b950-46260707acce"
    }
  }
}
